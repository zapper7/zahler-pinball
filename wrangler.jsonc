{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zahler-pinball",
  "compatibility_date": "2026-07-07",
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ZAHLER_EVENTS",
      "dataset": "zahler_events"
    }
  ]
}
